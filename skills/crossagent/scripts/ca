#!/usr/bin/env bash
# ca: split work across this Mac and the Linux PC (`ssh pc`) in tmux sessions
# named ca-<project>-<host>-<task>, so the CrossAgent viewing station shows them.
# Run `ca help` for usage.
set -eu

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

CA="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONF="$HOME/.config/crossagent"
MAP="$CONF/system-map.md"
SSH_OPTS="-o ControlMaster=auto -o ControlPath=/tmp/crossagent-%C -o ControlPersist=10m -o ServerAliveInterval=15"
RCA='~/.claude/skills/crossagent/scripts/ca'

die() { echo "ca: $*" >&2; exit 1; }
say() { echo "ca: $*" >&2; }
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
qall() { local a out=""; for a in "$@"; do out="$out $(q "$a")"; done; printf %s "$out"; }

case "$(uname -s)" in Darwin) HERE=mac ;; *) HERE=pc ;; esac
HERE="${CA_HERE:-$HERE}"

# ---------- project ----------

# Project slug for session names. Must match ProjectSlug.make in
# Sources/CrossAgent/Core/Contracts.swift: lowercase a-z 0-9, any other run becomes
# one '-', dashes trimmed, cut to 16, trimmed again, empty becomes 'project'.
slug() {
  local s
  s="$(printf %s "$1" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//' | cut -c1-16 | sed 's/-*$//')"
  echo "${s:-project}"
}

set_root() {
  ROOT="$1"
  NAME="$(basename "$ROOT" | tr -c 'A-Za-z0-9._\n-' '_')"
  SLUG="$(slug "$(basename "$ROOT")")"
  PROJ_CONF="$ROOT/.crossagent/project"
}
set_root "${CA_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
# The Mac passes its slug along so a PC folder with another name (pc_dir=) still matches.
SLUG="${CA_SLUG:-$SLUG}"

# tmux session for a task in this project: ca-<slug>-<host>-<task>
sname() { echo "ca-$SLUG-$1-$2"; }

# `ca portal start|stop <path>` works on another folder than the current one.
root_from() {
  [ -d "$1" ] || die "no such folder: $1"
  set_root "$(cd "$1" && { git rev-parse --show-toplevel 2>/dev/null || pwd; })"
}

conf_get() { [ -f "$PROJ_CONF" ] && sed -n "s/^$1=//p" "$PROJ_CONF" | head -1 || true; }
conf_list() { conf_get "$1" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true; }

# Same path relative to home on both machines (~/Projects/x <-> ~/Projects/x).
# Projects outside home go to ~/crossagent/projects/<name>. pc_dir= in .crossagent/project overrides.
pc_dir() {
  local d; d="$(conf_get pc_dir)"
  if [ -n "$d" ]; then echo "$d"; return; fi
  case "$ROOT" in "$HOME"/*) echo "${ROOT#"$HOME"/}" ;; *) echo "crossagent/projects/$NAME" ;; esac
}

# ---------- hosts ----------

resolve() {
  local w
  w="$(echo "$*" | tr 'A-Z' 'a-z' | sed -E 's/^ *//; s/ *$//; s/^(on|in|at) +//; s/^(my|this|the) +//')"
  case "$w" in
    local|mac|macbook|laptop|here|localhost) echo mac ;;
    pc|ssh|overseas|linux|remote|desktop|ubuntu|box) echo pc ;;
    ""|both|split|all|everywhere) echo both ;;
    *) return 1 ;;
  esac
}

host_arg() {
  local h
  h="$(resolve "$1")" || die "unknown host '$1' (use mac, pc or a nickname, see ca help)"
  [ "$h" = both ] && die "pick one host for this, mac or pc"
  if [ "$HERE" = pc ] && [ "$h" = mac ]; then
    die "running on the PC, which can't reach the Mac. Everything runs here, use 'pc'"
  fi
  echo "$h"
}

# Run "$@" on the PC inside the project's PC dir with the PC's own ca. Read only
# calls (probe, status) run in home if the folder isn't there, so a Mac only
# project never leaves an empty folder on the PC.
on_pc() {
  local dir mk; dir="$(pc_dir)"
  case "$1" in
    __probe|__status) mk="{ cd $(q "$dir") 2>/dev/null || cd; }" ;;
    *) mk="mkdir -p $(q "$dir") && cd $(q "$dir")" ;;
  esac
  # shellcheck disable=SC2086
  ssh $SSH_OPTS pc "PATH=\$HOME/.local/bin:\$PATH; $mk && CA_ROOT=\$PWD CA_SLUG=$(q "$SLUG") exec $RCA$(qall "$@")"
}

remote_ok() {
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o ConnectTimeout=20 pc "test -x $RCA" 2>/dev/null
}

ensure_remote() {
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o ConnectTimeout=20 pc true 2>/dev/null || die "can't reach the PC with 'ssh pc'. Is it on?"
  remote_ok || { say "skill missing on the PC, installing"; "$SKILL_DIR/install.sh" --pc >&2; }
}

# ---------- one-off copies (push, pull) ----------

EXCLUDES=(
  --exclude=.DS_Store --exclude=node_modules --exclude=.build --exclude=DerivedData
  --exclude=.swiftpm --exclude=.venv --exclude=venv --exclude=__pycache__
  --exclude=.next --exclude=.gradle --exclude=.cache --exclude=.pytest_cache
  --exclude=/build/ --exclude=/dist/ --exclude=/target/ --exclude=/out/
  --exclude=/.crossagent/logs/ --exclude=/.crossagent/results/
  --exclude=/.crossagent/run/ --exclude=/.crossagent/pc/
)

push() {
  [ "$HERE" = mac ] || die "push only makes sense on the Mac"
  local dir del=""; dir="$(pc_dir)"
  [ "${1:-}" = --delete ] && del="--delete"
  # shellcheck disable=SC2086
  ssh $SSH_OPTS pc "mkdir -p $(q "$dir")"
  # shellcheck disable=SC2086
  rsync -az $del "${EXCLUDES[@]}" -e "ssh $SSH_OPTS" "$ROOT/" "pc:$dir/"
  say "pushed $NAME to pc:~/$dir"
}

pull() {
  [ "$HERE" = mac ] || die "pull only makes sense on the Mac"
  local dir p; dir="$(pc_dir)"
  if [ $# -eq 0 ]; then
    mkdir -p "$ROOT/.crossagent/pc"
    for p in logs results; do
      rsync -az -e "ssh $SSH_OPTS" "pc:$dir/.crossagent/$p" "$ROOT/.crossagent/pc/" 2>/dev/null || true
    done
    say "pulled PC logs and results into .crossagent/pc/"
    return
  fi
  for p in "$@"; do
    p="${p%/}"
    case "$p" in /*|*..*) die "pull takes paths relative to the project: $p" ;; esac
    mkdir -p "$ROOT/$(dirname "$p")"
    rsync -az -e "ssh $SSH_OPTS" "pc:$dir/$p" "$ROOT/$(dirname "$p")/"
    say "pulled $p"
  done
}

# ---------- Crossover Portal (live sync with mutagen) ----------

# User facing name is "Crossover Portal" (or "Portal"). Internals keep the old sync names:
# Mutagen session ca-<project>, label ca-cfg, sync_allow=/sync_ignore= in .crossagent/project,
# and `ca sync ...` still works as an alias. Renaming any of those would orphan existing sessions.

# Per machine stuff and build output never cross over. .git is skipped with --ignore-vcs.
SYNC_IGNORES=(.build build DerivedData node_modules target dist .venv venv __pycache__ .DS_Store .crossagent/ '*.log')
# Secrets stay put unless the project opts in with sync_allow= in .crossagent/project.
SECRET_IGNORES=(.env '.env.*' '*.pem' '*.key' 'id_*')

sess() { echo "ca-$(echo "$NAME" | tr -c 'A-Za-z0-9\n' '-' | sed 's/--*/-/g; s/^-//; s/-$//')"; }
have_mutagen() { command -v mutagen >/dev/null 2>&1; }
need_mutagen() {
  [ "$HERE" = mac ] || die "the Crossover Portal is driven from the Mac"
  have_mutagen || die "mutagen isn't installed: brew install mutagen-io/mutagen/mutagen"
}
sync_exists() { mutagen sync list "$(sess)" >/dev/null 2>&1; }
sync_active() { [ "$HERE" = mac ] && have_mutagen && sync_exists; }

build_sync_args() {
  local p
  SARGS=(--mode=two-way-safe --ignore-vcs --symlink-mode=portable --permissions-mode=portable
         --default-file-mode=0644 --default-directory-mode=0755)
  for p in "${SYNC_IGNORES[@]}" "${SECRET_IGNORES[@]}"; do SARGS+=("--ignore=$p"); done
  while IFS= read -r p; do SARGS+=("--ignore=$p"); done < <(conf_list sync_ignore)
  while IFS= read -r p; do SARGS+=("--ignore=!$p"); done < <(conf_list sync_allow)
}

# name, status, paused, conflicts, problems, mac path, pc path, last error (last, it's often empty)
SYNC_TPL='{{range .}}{{.Name}}	{{.Status}}	{{.Paused}}	{{len .Conflicts}}	{{len .Alpha.ScanProblems}}{{len .Alpha.TransitionProblems}}{{len .Beta.ScanProblems}}{{len .Beta.TransitionProblems}}	{{.Alpha.Path}}	{{.Beta.Host}}:{{.Beta.Path}}	{{.LastError}}
{{end}}'

sync_rows() { mutagen sync list "$@" --template "$SYNC_TPL" 2>/dev/null | grep '^ca-' || true; }

# One word (plus detail) for a sync_rows line.
sync_word() {
  local status paused conflicts problems err
  IFS=$'\t' read -r _ status paused conflicts problems _ _ err <<< "$1"
  status="$(echo "$status" | tr 'A-Z' 'a-z')"
  if [ "$conflicts" != 0 ]; then echo "conflicts ($conflicts)"
  elif [ -n "$err" ]; then echo "error: $err"
  elif [ "$paused" = true ]; then echo paused
  else case "$status" in
    watching*) if [ "$problems" = 0000 ]; then echo "watching (in sync)"; else echo "watching (in sync, some paths skipped)"; fi ;;
    disconnected*|halted*) echo "$status" ;;
    *) echo "syncing ($status)" ;;
  esac; fi
}

sync_start() {
  need_mutagen
  local force="" s pcd hash cur r
  [ "${1:-}" = --force ] && { force=1; shift; }
  [ $# -eq 0 ] || root_from "$1"
  [ "$ROOT" != "$HOME" ] || die "won't open a Portal on your whole home folder, run this in a project"
  s="$(sess)"; pcd="$(pc_dir)"
  build_sync_args
  hash="$(printf '%s\n' "${SARGS[@]}" "$ROOT" "$pcd" | shasum | cut -c1-12)"
  if cur="$(mutagen sync list "$s" --template '{{range .}}{{index .Labels "ca-cfg"}}{{end}}' 2>/dev/null)"; then
    if [ "$cur" = "$hash" ]; then
      mutagen sync resume "$s" >/dev/null 2>&1 || true
      say "Portal $s already open"
      sync_flush
      return
    fi
    say "Portal rules or paths changed, recreating $s (files stay where they are)"
    mutagen sync terminate "$s" >/dev/null
  fi
  ensure_remote
  # Make the PC folder (mutagen won't create parents) and refuse to merge into a folder
  # that holds something else. The marker lives in .crossagent/, which never syncs.
  # shellcheck disable=SC2086
  r="$(ssh $SSH_OPTS pc "cd && if [ -n \"\$(ls -A $(q "$pcd") 2>/dev/null)\" ] && ! grep -qx $(q "name=$NAME") $(q "$pcd/.crossagent/project") 2>/dev/null; then echo foreign; else mkdir -p $(q "$pcd/.crossagent") && printf 'name=%s\n' $(q "$NAME") > $(q "$pcd/.crossagent/project") && echo ok; fi")"
  if [ "$r" = foreign ] && [ -z "$force" ]; then
    die "~/$pcd on the PC already has files that aren't this project. Move them, set pc_dir= in .crossagent/project, or run 'ca portal start --force' to merge (conflicts get flagged, nothing is overwritten)"
  fi
  [ "$r" = ok ] || [ -n "$force" ] || die "couldn't prepare ~/$pcd on the PC"
  mutagen sync create --name="$s" --label="ca-cfg=$hash" "${SARGS[@]}" "$ROOT" "pc:~/$pcd" >/dev/null
  say "Crossover Portal open: $(echo "$ROOT" | sed "s|^$HOME|~|") <-> pc:~/$pcd ($s)"
  sync_flush
}

# Waits for a full cycle. Exits non zero on conflicts or errors so nobody hands off stale or clashing files.
sync_flush() {
  need_mutagen
  local s row word; s="$(sess)"
  sync_exists || die "no Portal for $NAME, run: ca portal start"
  row="$(sync_rows "$s")"
  [ "$(echo "$row" | cut -f3)" = true ] && { sync_note "$s" paused; die "$s is paused, resume it with: mutagen sync resume $s"; }
  mutagen sync flush "$s" >/dev/null 2>&1 || { sync_note "$s" "flush failed"; die "couldn't flush $s, is the PC reachable? (ca portal status)"; }
  row="$(sync_rows "$s")"; word="$(sync_word "$row")"
  sync_note "$s" "$word"
  case "$word" in
    watching*) say "Portal flushed, $NAME is in sync"; sync_problems "$s" >&2 ;;
    conflicts*) say "$s has $word. Stop and sort them out first:"; sync_conflicts >&2; return 3 ;;
    *) die "$s: $word" ;;
  esac
}

# Paths Mutagen skipped (absolute symlinks, unreadable files). Not fatal, but worth knowing.
sync_problems() {
  mutagen sync list "$@" --template '{{range .}}{{$n := .Name}}{{range .Alpha.ScanProblems}}{{$n}}	mac	{{.Path}}	{{.Error}}
{{end}}{{range .Beta.ScanProblems}}{{$n}}	pc	{{.Path}}	{{.Error}}
{{end}}{{range .Alpha.TransitionProblems}}{{$n}}	mac	{{.Path}}	{{.Error}}
{{end}}{{range .Beta.TransitionProblems}}{{$n}}	pc	{{.Path}}	{{.Error}}
{{end}}{{end}}' 2>/dev/null | awk -F'\t' '$1 ~ /^ca-/ {print "  skipped on " $2 ": " $3 " (" $4 ")"}' || true
}

sync_status() {
  need_mutagen
  local rows row
  rows="$(sync_rows)"
  [ -n "$rows" ] || { echo "no Crossover Portals open"; return 0; }
  while IFS= read -r row; do
    printf '%-26s %-22s %s <-> %s\n' "$(echo "$row" | cut -f1)" "$(sync_word "$row")" \
      "$(echo "$row" | cut -f6 | sed "s|^$HOME|~|")" "$(echo "$row" | cut -f7)"
    sync_problems "$(echo "$row" | cut -f1)"
  done <<< "$rows"
}

change() {
  case "$1:$2" in
    none:*) echo "created ($2)" ;;
    *:none) echo "deleted (was $1)" ;;
    "$2:$2") echo "modified" ;;
    *) echo "changed from $1 to $2" ;;
  esac
}

stat_mac() { [ -e "$1" ] && /usr/bin/stat -f '%z bytes, modified %Sm' -t '%Y-%m-%d %H:%M:%S' "$1" || echo missing; }

# Every conflict with what each side did and what's there now. Never resolves anything.
sync_conflicts() {
  need_mutagen
  local spec=() n=0 sname mac pcp root=""
  sync_exists && spec=("$(sess)")
  hint() {
    [ -n "$root" ] || return 0
    echo "  keep the Mac version: ssh pc 'rm -r ~/$pcp/$root', then ca portal flush"
    echo "  keep the PC version:  rm -r '$mac/$root', then ca portal flush"
    root=""
  }
  while IFS=$'\t' read -r tag a b c d; do
    case "$tag" in
      S) hint; sname="$a"; mac="$b"; pcp="${c#\~/}" ;;
      R) hint; root="$a"; n=$((n + 1))
         echo "$sname: $root"
         echo "  mac  $(stat_mac "$mac/$root")"
         # -n: ssh must not eat the rest of this loop's input
         # shellcheck disable=SC2086
         echo "  pc   $(ssh -n $SSH_OPTS -o ConnectTimeout=20 pc "cd && stat -c '%s bytes, modified %y' $(q "$pcp/$root") 2>/dev/null | cut -d. -f1 | grep . || echo missing" 2>/dev/null || echo unreachable)"
         conflict_diff "$mac/$root" "$pcp/$root" ;;
      C) echo "  $a changed $b: $(change "$(echo "$c" | tr 'A-Z' 'a-z')" "$(echo "$d" | tr 'A-Z' 'a-z')")" ;;
    esac
  done < <(mutagen sync list ${spec[@]+"${spec[@]}"} --template '{{range .}}S	{{.Name}}	{{.Alpha.Path}}	{{.Beta.Path}}
{{range .Conflicts}}R	{{.Root}}
{{range .AlphaChanges}}C	mac	{{.Path}}	{{if .Old}}{{.Old.Kind}}{{else}}none{{end}}	{{if .New}}{{.New.Kind}}{{else}}none{{end}}
{{end}}{{range .BetaChanges}}C	pc	{{.Path}}	{{if .Old}}{{.Old.Kind}}{{else}}none{{end}}	{{if .New}}{{.New.Kind}}{{else}}none{{end}}
{{end}}{{end}}{{end}}' 2>/dev/null | awk -F'\t' '$1=="S"{ok=($2 ~ /^ca-/)} ok')
  hint
  if [ "$n" = 0 ]; then echo "no conflicts"; return 0; fi
  echo
  echo "Nothing was overwritten. Pick a side per file (or merge by hand on the Mac, then delete the PC copy)."
}

# Short diff (mac vs pc) when both sides are small text files.
conflict_diff() {
  [ -f "$1" ] && [ "$(/usr/bin/stat -f %z "$1")" -lt 65536 ] && grep -Iq . "$1" 2>/dev/null || return 0
  local tmp; tmp="$(mktemp)"
  # shellcheck disable=SC2086
  if ssh -n $SSH_OPTS -o ConnectTimeout=20 pc "cd && [ \$(stat -c %s $(q "$2")) -lt 65536 ] && grep -Iq . $(q "$2") && cat $(q "$2")" > "$tmp" 2>/dev/null; then
    diff -u --label mac --label pc "$1" "$tmp" | sed -n '3,22p' | sed 's/^/    /'
  fi
  rm -f "$tmp"
}

sync_stop() {
  need_mutagen
  [ $# -eq 0 ] || root_from "$1"
  local s; s="$(sess)"
  if sync_exists; then
    mutagen sync terminate "$s" >/dev/null
    sync_note "$s" stopped
    echo "closed Portal $s, files stay on both machines"
  else
    echo "Portal $s wasn't open"
  fi
}

# ---------- system map ----------

probe() {
  local os cpu cores ram disk
  if [ "$(uname -s)" = Darwin ]; then
    os="$(sw_vers -productName) $(sw_vers -productVersion) ($(uname -m))"
    cpu="$(sysctl -n machdep.cpu.brand_string), model $(sysctl -n hw.model)"
    cores="$(sysctl -n hw.ncpu) cores ($(sysctl -n hw.perflevel0.physicalcpu 2>/dev/null || echo ?) performance)"
    ram="$(( $(sysctl -n hw.memsize) / 1073741824 )) GB"
  else
    os="$(. /etc/os-release && echo "$PRETTY_NAME"), kernel $(uname -r) ($(uname -m))"
    cpu="$(lscpu | sed -n 's/^Model name: *//p' | head -1)"
    cores="$(nproc) threads, $(lscpu | awk -F: '/^Core\(s\) per socket/{gsub(/ /,"",$2); print $2}') cores"
    ram="$(free -g | awk '/^Mem:/{print $2}') GB usable, $(free -g | awk '/^Swap:/{print $2}') GB swap"
  fi
  disk="$(df -h "$HOME" | awk 'NR==2{print $4" free of "$2}')"
  echo "- OS: $os"
  echo "- CPU: $cpu"
  echo "- Cores: $cores"
  echo "- RAM: $ram"
  echo "- Disk (home): $disk"
  echo "- Shell: $(basename "${SHELL:-sh}")"
  echo "- Tools:"
  local t v
  for t in git tmux claude rsync make node npm python3 swift xcodebuild docker brew; do
    command -v "$t" >/dev/null 2>&1 || continue
    case "$t" in
      tmux) v="$(tmux -V)" ;;
      rsync) v="$(rsync --version 2>&1 | head -1)" ;;
      xcodebuild) v="$(xcodebuild -version 2>/dev/null | head -1)" ;;
      swift) v="$(swift --version 2>&1 | grep -m1 -o 'Swift version [0-9.]*')" ;;
      docker) v="$(docker --version 2>/dev/null)" ;;
      *) v="$("$t" --version 2>&1 | head -1)" ;;
    esac
    echo "  - $t: $v ($(command -v "$t" | sed "s|^$HOME|~|"))"
  done
  echo "- Skill: ~/.claude/skills/crossagent (ca at ~/.claude/skills/crossagent/scripts/ca)"
}

block() { [ -f "$MAP" ] && awk -v s="<!-- ca:$1 -->" -v e="<!-- /ca:$1 -->" '$0==s{f=1;next} $0==e{f=0} f' "$MAP" || true; }

# projects file: name, mac path, pc path, portal session, last portal status (tab separated)
register_project() {
  mkdir -p "$CONF"
  local f="$CONF/projects" macd="-" pcd old
  [ "$HERE" = mac ] && macd="$(echo "$ROOT" | sed "s|^$HOME|~|")"
  pcd="~/$(pc_dir)"
  touch "$f"
  old="$(awk -F'\t' -v n="$NAME" '$1==n' "$f")"
  grep -v "^$NAME	" "$f" > "$f.tmp" || true
  printf '%s\t%s\t%s\t%s\t%s\n' "$NAME" "$macd" "$pcd" \
    "${1:-$(echo "$old" | cut -sf4)}" "${2:-$(echo "$old" | cut -sf5)}" >> "$f.tmp"
  sort "$f.tmp" > "$f" && rm -f "$f.tmp"
}

projects_table() {
  echo "| project | mac | pc | portal session | last portal status |"
  echo "|---|---|---|---|---|"
  awk -F'\t' '{print "| "$1" | "$2" | "$3" | "($4==""?"-":$4)" | "($5==""?"-":$5)" |"}' "$CONF/projects" 2>/dev/null || true
}

copy_map_to_pc() {
  # shellcheck disable=SC2086
  ssh $SSH_OPTS -o ConnectTimeout=10 pc 'mkdir -p ~/.config/crossagent && cat > ~/.config/crossagent/system-map.md' < "$MAP" 2>/dev/null || true
}

# Record a Portal status in the map, only when it changed, so flushes stay cheap.
sync_note() {
  local cur
  cur="$(awk -F'\t' -v n="$NAME" '$1==n{print $5}' "$CONF/projects" 2>/dev/null | sed 's/ (since .*//')"
  [ "$cur" = "$2" ] && return 0
  register_project "$1" "$2 (since $(date '+%Y-%m-%d %H:%M'))"
  [ -f "$MAP" ] || return 0
  TBL="$(projects_table)" awk '/^## Projects$/{print; print ""; print ENVIRON["TBL"]; print ""; skip=1; next} /^## /{skip=0} !skip' "$MAP" > "$MAP.tmp" && mv "$MAP.tmp" "$MAP"
  [ -d "$ROOT/.crossagent" ] && cp "$MAP" "$ROOT/.crossagent/system-map.md"
  copy_map_to_pc
}

build_map() {
  local mac pc notes
  if [ "$HERE" = mac ]; then
    mac="$(probe)"
    if remote_ok; then pc="$(on_pc __probe)"; else pc="$(block pc)"; say "PC unreachable, kept its old map section"; fi
  else
    pc="$(probe)"; mac="$(block mac)"
  fi
  notes="$( [ -f "$MAP" ] && awk 'f; /^## Notes/{f=1}' "$MAP" || true)"
  [ -n "$notes" ] || notes="Add your own notes here. ca keeps this section when it refreshes the map."
  mkdir -p "$CONF"
  {
    echo "# CrossAgent system map"
    echo
    echo "Generated by ca on $(date '+%Y-%m-%d %H:%M') from the $HERE. Everything above Notes gets regenerated."
    echo
    echo "## How to reach each machine"
    echo
    echo "- mac (nicknames: local, mac, this mac, on my mac): the hub and source of truth for code. Runs things locally."
    echo "- pc (nicknames: pc, ssh, overseas, my pc, on my pc): reached from the Mac with \`ssh pc\`. Use ssh options \`$SSH_OPTS\`. Login shell needed for PATH (\`ssh pc 'exec \$SHELL -lc \"...\"'\`)."
    echo "- The PC can't reach the Mac. Run from the PC, ca works PC only."
    echo "- tmux sessions are named ca-<project>-<host>-<task> and show up in the CrossAgent viewing station."
    echo "- Projects are mirrored live through the Crossover Portal (Mutagen session ca-<project>, two-way-safe, same path under home on both). Git lives on the Mac only."
    echo
    echo "<!-- ca:mac -->"
    echo "## mac"
    echo
    echo "$mac" | sed '/^## mac$/d; /^$/d'
    echo "<!-- /ca:mac -->"
    echo
    echo "<!-- ca:pc -->"
    echo "## pc"
    echo
    echo "$pc" | sed '/^## pc$/d; /^$/d'
    echo "<!-- /ca:pc -->"
    echo
    echo "## Projects"
    echo
    projects_table
    echo
    echo "## Notes"
    echo
    echo "$notes" | sed '/./,$!d'
  } > "$MAP.tmp"
  mv "$MAP.tmp" "$MAP"
  if [ "$HERE" = mac ] && remote_ok; then copy_map_to_pc; fi
  say "map written to ~/.config/crossagent/system-map.md$([ "$HERE" = mac ] && echo ' (and copied to the PC)')"
}

project_map() {
  [ -f "$MAP" ] || return 0
  mkdir -p "$ROOT/.crossagent"
  cp "$MAP" "$ROOT/.crossagent/system-map.md"
}

# ---------- init ----------

init() {
  # Where the work goes: both (default, Portal), mac only (no Portal), pc only (one-off push, no Portal).
  local mode=both
  if [ $# -gt 0 ]; then mode="$(resolve "$*")" || die "unknown machine '$*' (mac, pc or both)"; fi
  mkdir -p "$ROOT/.crossagent"
  [ -f "$PROJ_CONF" ] || printf 'name=%s\n# pc_dir=other/path/under/home\n# sync_allow=.env.shared,*.pem   (opt in to sending these through the Portal, comma separated)\n# sync_ignore=data,*.sqlite     (extra Portal ignores)\n' "$NAME" > "$PROJ_CONF"

  if [ ! -f "$ROOT/CROSSAGENT.md" ]; then
    cp "$SKILL_DIR/templates/CROSSAGENT.md" "$ROOT/CROSSAGENT.md"; say "added CROSSAGENT.md"
  elif ! cmp -s "$SKILL_DIR/templates/CROSSAGENT.md" "$ROOT/CROSSAGENT.md"; then
    say "CROSSAGENT.md differs from the template, leaving it (delete it and re-run init to reset)"
  fi

  local line="Read CROSSAGENT.md for how to split work across the Mac and the PC (crossagent skill)."
  if [ ! -f "$ROOT/CLAUDE.md" ] || ! grep -q 'CROSSAGENT.md' "$ROOT/CLAUDE.md"; then
    if [ -s "$ROOT/CLAUDE.md" ]; then
      [ -z "$(tail -c1 "$ROOT/CLAUDE.md")" ] || echo >> "$ROOT/CLAUDE.md"
      printf '\n%s\n' "$line" >> "$ROOT/CLAUDE.md"
    else
      printf '%s\n' "$line" > "$ROOT/CLAUDE.md"
    fi
    say "added CROSSAGENT.md pointer to CLAUDE.md"
  fi

  if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if ! grep -qxE '/?\.crossagent/?' "$ROOT/.gitignore" 2>/dev/null; then
      [ ! -s "$ROOT/.gitignore" ] || [ -z "$(tail -c1 "$ROOT/.gitignore")" ] || echo >> "$ROOT/.gitignore"
      echo ".crossagent/" >> "$ROOT/.gitignore"; say "added .crossagent/ to .gitignore"
    fi
  fi

  register_project
  [ "$HERE" = mac ] && [ "$mode" != mac ] && ensure_remote
  build_map
  project_map
  if [ "$HERE" != mac ]; then say "on the PC: PC only mode, no Portal"
  elif [ "$mode" = mac ]; then say "Mac only: no Portal"
  elif [ "$mode" = pc ]; then push
  elif have_mutagen; then sync_start
  else say "mutagen isn't installed so no Portal, falling back to a one-off push (brew install mutagen-io/mutagen/mutagen)"; push; fi
  echo "ready: $NAME  mac=$( [ "$HERE" = mac ] && echo "$ROOT" | sed "s|^$HOME|~|" || echo -)  pc=$( [ "$mode" = mac ] && echo - || echo "~/$(pc_dir)")"
}

# ---------- tasks ----------

# 40 keeps ca-<slug, max 16>-<host>-<task> within 64 chars.
check_task() {
  echo "$1" | grep -qE '^[A-Za-z0-9_-]{1,40}$' || die "task name must be 1-40 chars of A-Z a-z 0-9 _ - (got '$1')"
}

# Appends one WorkerStart/WorkerStop line to ~/.crossagent/events/<session>.jsonl for the
# app's event pipeline. Best effort: any failure is swallowed so the task never notices.
# event <ev> <host> <session> <slug> <task> <cwd or rc> <summary text>
event() {
  local py=/usr/bin/python3
  [ -x "$py" ] || py="$(command -v python3 2>/dev/null)" || return 0
  "$py" -I -c '
import json, os, re, sys, time
ev, host, sid, proj, node, extra, text = sys.argv[1:8]
d = os.path.expanduser("~/.crossagent/events")
os.makedirs(d, mode=0o700, exist_ok=True)
text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b.", "", text)
text = " ".join(text.split())[:160].encode("utf-8", "replace").decode("utf-8")
e = {"ts": time.time(), "ev": ev, "host": host, "sid": sid, "tmux": sid, "project": proj,
     "role": "worker", "node": node, "name": node}
if ev == "WorkerStart":
    e["cwd"] = extra
else:
    e["rc"] = int(extra) if re.fullmatch(r"-?[0-9]+", extra) else -1
e["sum"] = text
fd = os.open(os.path.join(d, sid + ".jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
with os.fdopen(fd, "a") as f:
    f.write(json.dumps(e) + "\n")
' "$@" >/dev/null 2>&1 || true
}

run() {
  [ $# -ge 2 ] || die "usage: ca run <host> <task> [--claude \"prompt\"] [-- command...]"
  local host task mode prompt=""; host="$(host_arg "$1")"; task="$2"; shift 2
  check_task "$task"
  case "${1:-}" in
    --claude) [ $# -ge 2 ] || die "--claude needs a prompt"; mode=claude; prompt="$2"; shift 2 ;;
    --) shift; [ $# -ge 1 ] || die "nothing to run after --"; mode=cmd ;;
    *) die "say what to run: --claude \"prompt\" or -- command" ;;
  esac
  # Hand off only fresh files: flush the Portal (or push once without it).
  if sync_active; then sync_flush; elif [ "$host" != "$HERE" ]; then push; fi
  if [ "$host" != "$HERE" ]; then
    if [ "$mode" = claude ]; then on_pc run pc "$task" --claude "$prompt"; else on_pc run pc "$task" -- "$@"; fi
    return
  fi
  local s d="$ROOT/.crossagent"; s="$(sname "$host" "$task")"
  if tmux has-session -t "=$s" 2>/dev/null; then
    [ -f "$d/run/$task.exit" ] || die "$s is still running. Use ca wait, or ca stop $host $task"
    tmux kill-session -t "=$s"
  fi
  mkdir -p "$d/logs" "$d/results" "$d/run"
  rm -f "$d/logs/$task.log" "$d/results/$task.md" "$d/run/$task.exit"
  echo "$mode" > "$d/run/$task.mode"
  # Tags the session so Claude Code hooks inside it (and the runner) know who they are.
  local env=(-e "CROSSAGENT_PROJECT=$SLUG" -e CROSSAGENT_ROLE=worker -e "CROSSAGENT_NODE=$task" -e "CROSSAGENT_HOST=$host")
  if [ "$mode" = claude ]; then
    tmux new-session -d -s "$s" "${env[@]}" -c "$ROOT" "$CA" __run "$task" claude "$prompt"
  else
    tmux new-session -d -s "$s" "${env[@]}" -c "$ROOT" "$CA" __run "$task" cmd "$@"
  fi
  echo "started $s in $(echo "$ROOT" | sed "s|^$HOME|~|")"
}

# Runs inside the tmux session.
runner() {
  local task="$1" mode="$2"; shift 2
  local d="$ROOT/.crossagent" rc start last; start="$(date +%s)"
  local log="$d/logs/$task.log" res="$d/results/$task.md"
  SLUG="${CROSSAGENT_PROJECT:-$SLUG}"
  local s; s="$(sname "$HERE" "$task")"
  event WorkerStart "$HERE" "$s" "$SLUG" "$task" "$ROOT" "$*"
  # Ctrl+C in the worker's terminal is for the command, not for this runner: keep going so
  # the result and WorkerStop still get written. A handler (not ignore) resets in children.
  trap ':' INT
  if [ "$mode" = claude ]; then
    tmux pipe-pane -o -t "${TMUX_PANE:-}" "cat >> $(q "$log")" || true
    local p="$1

You are a crossagent worker on the $HERE, task '$task', in $ROOT. When you are done, write a short result (what you did, files touched, outcome, anything the user must do) to .crossagent/results/$task.md, then say you're done."
    set +e; claude --permission-mode acceptEdits "$p"; rc=$?; set -e
    [ -f "$res" ] || printf '# %s on %s\n\nClaude exited (code %s) without writing a result.\n' "$task" "$HERE" "$rc" > "$res"
  else
    echo "[ca] $HERE $task: $*"
    set +e
    { trap ':' INT; if [ $# -eq 1 ]; then bash -c "$1"; else "$@"; fi; echo $? > "$d/run/$task.rc"; } 2>&1 | tee -i "$log"
    set -e
    rc="$(cat "$d/run/$task.rc" 2>/dev/null || echo 1)"; rm -f "$d/run/$task.rc"
    {
      echo "# $task on $HERE"
      echo
      echo "- command: \`$*\`"
      echo "- exit: $rc ($([ "$rc" = 0 ] && echo ok || echo failed))"
      echo "- took: $(( $(date +%s) - start ))s"
      echo "- log: .crossagent/logs/$task.log"
      echo
      echo "Last lines:"
      echo
      echo '```'
      tail -n 15 "$log"
      echo '```'
    } > "$res"
  fi
  echo "$rc" > "$d/run/$task.exit"
  # Last output line: the log for commands, the result for Claude (its log is raw terminal bytes).
  if [ "$mode" = claude ]; then last="$(grep -v '^[[:space:]]*$' "$res" 2>/dev/null | tail -n 1)" || true
  else last="$(grep -v '^[[:space:]]*$' "$log" 2>/dev/null | tail -n 1)" || true; fi
  event WorkerStop "$HERE" "$s" "$SLUG" "$task" "$rc" "$last"
  echo
  echo "[ca] $task finished with exit $rc. Session stays open, close it with: ca stop $HERE $task"
  exec "${SHELL:-bash}" -l
}

state() {
  local d="$ROOT/.crossagent/run" task="$1"
  if [ -f "$d/$task.exit" ]; then echo "done (exit $(cat "$d/$task.exit"))"
  elif [ -f "$ROOT/.crossagent/results/$task.md" ]; then echo "done (result written)"
  elif tmux has-session -t "=$(sname "$HERE" "$task")" 2>/dev/null; then echo running
  else echo "not running"; fi
}

# Old ca-<host>-<task> name from before projects? Same rule as CASessionName.parse.
legacy() {
  local h t
  for h in mac pc; do
    case "$1" in ca-"$h"-?*) t="${1#ca-"$h"-}"
      case "$t" in mac-*|pc-*) ;; *) return 0 ;; esac ;;
    esac
  done
  return 1
}

# This project's tasks show their state, old style sessions say legacy, other projects get -.
local_status() {
  local s t p; p="$(sname "$HERE" "")"
  for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep '^ca-' || true); do
    t="${s#"$p"}"
    if [ "$t" != "$s" ] && [ -f "$ROOT/.crossagent/run/$t.mode" ]; then printf '%-4s %-44s %s\n' "$HERE" "$s" "$(state "$t")"
    elif legacy "$s"; then printf '%-4s %-44s %s\n' "$HERE" "$s" legacy
    else printf '%-4s %-44s %s\n' "$HERE" "$s" "-"; fi
  done
}

status() {
  local_status
  if [ "$HERE" = mac ]; then on_pc __status 2>/dev/null || echo "pc   (unreachable)"; fi
}

logs() {
  [ $# -ge 2 ] || die "usage: ca logs <host> <task> [lines]"
  local host task n="${3:-60}"; host="$(host_arg "$1")"; task="$2"; check_task "$task"
  [ "$host" = "$HERE" ] || { on_pc logs pc "$task" "$n"; return; }
  local s; s="$(sname "$host" "$task")"
  if [ "$(cat "$ROOT/.crossagent/run/$task.mode" 2>/dev/null)" = claude ] && tmux has-session -t "=$s" 2>/dev/null; then
    tmux capture-pane -p -J -S -"$n" -t "=$s:" | sed '/^$/N;/^\n$/D' | tail -n "$n"
  elif [ -f "$ROOT/.crossagent/logs/$task.log" ]; then
    tail -n "$n" "$ROOT/.crossagent/logs/$task.log"
  else
    die "no log for $task on $host"
  fi
}

wait_one() {
  local host task t="$3"; host="$(host_arg "$1")"; task="$2"; check_task "$task"
  [ "$host" = "$HERE" ] || { on_pc wait pc "$task" --timeout "$t"; return; }
  local end=$(( $(date +%s) + t )) st s; s="$(sname "$host" "$task")"
  while :; do
    st="$(state "$task")"
    case "$st" in
      done*) break ;;
      "not running") echo "$s: not running and no result"; return 1 ;;
    esac
    [ "$(date +%s)" -lt "$end" ] || { echo "$s: still running after ${t}s, call ca wait again"; return 124; }
    sleep 2
  done
  echo "$s: $st"
  cat "$ROOT/.crossagent/results/$task.md" 2>/dev/null || true
  local rc; rc="$(cat "$ROOT/.crossagent/run/$task.exit" 2>/dev/null || echo 0)"
  return "$rc"
}

waitcmd() {
  local t=110 args=() rc=0
  while [ $# -gt 0 ]; do
    case "$1" in --timeout) t="$2"; shift 2 ;; *) args+=("$1"); shift ;; esac
  done
  [ "${#args[@]}" -ge 2 ] && [ $(( ${#args[@]} % 2 )) -eq 0 ] || die "usage: ca wait <host> <task> [<host> <task>...] [--timeout secs]"
  set -- "${args[@]}"
  local remote=""
  while [ $# -gt 0 ]; do
    local r=0; wait_one "$1" "$2" "$t" || r=$?
    [ "$r" -eq 0 ] || rc="$r"
    [ "$(resolve "$1")" = "$HERE" ] || remote=1
    [ $# -le 2 ] || echo
    shift 2
  done
  # Pull the other machine's output in before anyone reads it.
  if [ -n "$remote" ] && [ "$rc" != 124 ] && sync_active; then sync_flush || rc=$?; fi
  return "$rc"
}

stop() {
  [ $# -ge 2 ] || die "usage: ca stop <host> <task>"
  local host task; host="$(host_arg "$1")"; task="$2"; check_task "$task"
  [ "$host" = "$HERE" ] || { on_pc stop pc "$task"; return; }
  local s; s="$(sname "$host" "$task")"
  # Falls back to the old ca-<host>-<task> name so sessions from before projects can be stopped too.
  if ! tmux has-session -t "=$s" 2>/dev/null && tmux has-session -t "=ca-$host-$task" 2>/dev/null; then s="ca-$host-$task"; fi
  if tmux kill-session -t "=$s" 2>/dev/null; then
    echo "stopped $s"
    # A task that finished already logged its WorkerStop; one cut short gets one here.
    [ -f "$ROOT/.crossagent/run/$task.exit" ] || event WorkerStop "$HERE" "$s" "$SLUG" "$task" 0 "Stopped with ca stop"
  else
    echo "$s wasn't running"
  fi
  rm -f "$ROOT/.crossagent/run/$task.mode"
}

usage() {
  cat <<'EOF'
ca: split work across the Mac and the PC

  ca init [mac|pc]              set up this project (CROSSAGENT.md, CLAUDE.md pointer, map) and open
                                the Crossover Portal. With mac: no Portal. With pc: one-off push, no Portal.
  ca map [--refresh]            print the system map, or re-probe both machines first
  ca host <word>                nickname -> mac | pc | both  (local, this mac -> mac; pc, ssh, overseas -> pc)
  ca portal start [--force] [path]
                                open the Crossover Portal: live two-way-safe sync to the same path
                                on the PC (Mutagen session ca-<project>)
  ca portal status              one line per open Portal
  ca portal flush               sync now and wait, fails on conflicts (run and wait do this for you)
  ca portal conflicts           list conflicting files with both sides' info, resolves nothing
  ca portal stop [path]         close the Portal, files stay on both machines
  ca portal push [--delete]     one-off rsync Mac -> PC, for when the Portal is closed
  ca portal pull [paths...]     copy paths back from the PC (no paths: PC logs and results into .crossagent/pc/)
  ca run <host> <task> -- cmd   run a command in tmux session ca-<project>-<host>-<task> (flushes the Portal first)
  ca run <host> <task> --claude "prompt"
                                start an interactive Claude Code worker (acceptEdits) in that session
  ca status                     list ca-* sessions on both machines (old ca-<host>-<task> ones show as legacy)
  ca logs <host> <task> [n]     last n lines of output (default 60)
  ca wait <host> <task> [<host> <task>...] [--timeout secs]
                                wait until done (default 110s), print results, exit with the task's code
  ca stop <host> <task>         kill the session

Logs: .crossagent/logs/<task>.log, results: .crossagent/results/<task>.md, on the host that ran it.
<project> is the folder name as a slug (lowercase a-z 0-9 and -, max 16). Task names: up to 40 chars.
Workers log WorkerStart/WorkerStop events to ~/.crossagent/events/<session>.jsonl.
A single command string after -- runs through bash -c, so pipes and && work.
`ca sync ...` is the old name for `ca portal ...` and still works the same.
EOF
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  init) init "$@" ;;
  map)
    if [ "${1:-}" = --refresh ] || [ ! -f "$MAP" ]; then
      [ "$HERE" = mac ] && ensure_remote; register_project; build_map; project_map
    fi
    cat "$MAP" ;;
  host) h="$(resolve "$*")" || die "unknown nickname '$*'"; echo "$h" ;;
  portal|sync)
    case "${1:-}" in
      start) shift; sync_start "$@" ;;
      status) sync_status ;;
      flush) sync_flush ;;
      conflicts) sync_conflicts ;;
      stop) shift; sync_stop "$@" ;;
      push) shift; push "$@" ;;
      pull) shift; pull "$@" ;;
      *) die "usage: ca portal start|status|flush|conflicts|stop|push|pull" ;;
    esac ;;
  run) run "$@" ;;
  status) status ;;
  logs) logs "$@" ;;
  wait) waitcmd "$@" ;;
  stop) stop "$@" ;;
  __run) runner "$@" ;;
  __probe) probe ;;
  __status) local_status ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
